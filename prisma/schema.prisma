datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Employee {
  id           String       @id @default(uuid())
  name         String
  department   String
  position     String
  email        String       @unique
  passwordHash String
  role         String       @default("USER")
  attendances  Attendance[]
  leaves       Leave[]
  onsites      Onsite[]
  workdayChanges WorkdayChangeRequest[]
  approvedWorkdayChanges WorkdayChangeRequest[] @relation("ApprovedWorkdayChanges")
  createdAt    DateTime     @default(now())
}

model Attendance {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  date       DateTime  @default(now())
  checkIn    DateTime?
  checkOut   DateTime?
  status     String // "PRESENT", "LATE", "ABSENT"
}

model Leave {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  type       String // "SICK", "PERSONAL", "VACATION"
  startDate  DateTime
  endDate    DateTime
  reason     String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
}

model WorkdayChangeRequest {
  id           String    @id @default(uuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  fromDate     DateTime
  toDate       DateTime
  project      String
  jobDetail    String
  status       String    @default("WAITING_FOR_APPROVAL")
  approvedById String?
  approvedBy   Employee? @relation("ApprovedWorkdayChanges", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
}

model Onsite {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  location   String
  purpose    String
  startDate  DateTime
  endDate    DateTime
  allowance  Float?
  status     String   @default("APPROVED")
  createdAt  DateTime @default(now())
}
