datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Employee {
  id         String       @id @default(uuid())
  name       String
  department String
  position   String
  email      String       @unique
  attendances Attendance[]
  leaves     Leave[]
  onsites    Onsite[]
  createdAt  DateTime     @default(now())
}

model Attendance {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  date       DateTime @default(now())
  checkIn    DateTime?
  checkOut   DateTime?
  status     String   // "PRESENT", "LATE", "ABSENT"
}

model Leave {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  type       String   // "SICK", "PERSONAL", "VACATION"
  startDate  DateTime
  endDate    DateTime
  reason     String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
}

model Onsite {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  location    String
  purpose     String
  startDate   DateTime
  endDate     DateTime
  allowance   Float?
  status      String   @default("APPROVED")
  createdAt   DateTime @default(now())
}