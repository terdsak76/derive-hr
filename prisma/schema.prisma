datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Employee {
  id                     String                 @id @default(uuid())
  name                   String
  kbizName               String                 @default("")
  department             String
  position               String
  email                  String                 @unique
  passwordHash           String
  role                   String                 @default("USER")
  monthlySalaryCents     Int?
  fullIncentiveCents     Int                    @default(0)
  isOwner                Boolean                @default(false)
  attendances            Attendance[]
  leaves                 Leave[]
  onsites                Onsite[]
  workdayChanges         WorkdayChangeRequest[]
  approvedWorkdayChanges WorkdayChangeRequest[] @relation("ApprovedWorkdayChanges")
  overtimes              Overtime[]             @relation("OvertimeEmployee")
  createdOvertimes       Overtime[]             @relation("OvertimeCreator")
  approvedOvertimes      Overtime[]             @relation("OvertimeApprover")
  incentives             Incentive[]
  salaryIncentiveHistory SalaryIncentiveHistory[]
  kbizPayments           KbizEmployeeAllocation[]
  createdAt              DateTime               @default(now())
}

model SalaryIncentiveHistory {
  id                 String   @id @default(cuid())
  employeeId         String
  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  salaryCents        Int?
  fullIncentiveCents Int
  startDate          DateTime
  endDate            DateTime?
  isOpening          Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@unique([employeeId, startDate])
  @@map("salary_incentive_history")
}

model Attendance {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  date       DateTime  @default(now())
  checkIn    DateTime?
  checkOut   DateTime?
  project    String?
  jobDetail  String?
  status     String // "PRESENT", "LATE", "ABSENT"
}

model Leave {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  type       String // "SICK", "PERSONAL", "VACATION"
  period     String   @default("FULL_DAY") // "FULL_DAY", "MORNING", "AFTERNOON"
  startDate  DateTime
  endDate    DateTime
  reason     String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
}

model WorkdayChangeRequest {
  id           String    @id @default(uuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  fromDate     DateTime
  toDate       DateTime
  fromDateStart String?  // Thai local time, HH:mm
  fromDateEnd   String?
  toDateStart   String?
  toDateEnd     String?
  project      String
  jobDetail    String
  status       String    @default("WAITING_FOR_APPROVAL")
  approvedById String?
  approvedBy   Employee? @relation("ApprovedWorkdayChanges", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
}

model Onsite {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  location   String
  purpose    String
  startDate  DateTime
  endDate    DateTime
  allowance  Float?
  status     String   @default("APPROVED")
  createdAt  DateTime @default(now())
}

model TravelConfig {
  id                   String   @id @default(cuid())
  month                String   @unique
  fuelPrice            Float
  carKmPerLiter        Float
  motorcycleKmPerLiter Float
  depreciationPerKm    Float
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Overtime {
  id              String   @id @default(uuid())
  employeeId      String
  employee        Employee @relation("OvertimeEmployee", fields: [employeeId], references: [id])
  startAt         DateTime
  endAt           DateTime
  workedMinutes   Int
  hourlyRateCents Int
  otAmountCents   Int
  createdById     String
  createdBy       Employee @relation("OvertimeCreator", fields: [createdById], references: [id])
  status          String   @default("PENDING_APPROVAL")
  approvedById    String?
  approvedBy      Employee? @relation("OvertimeApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([employeeId, startAt])
  @@index([startAt, createdAt])
  @@map("OT")
}

model Incentive {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  month       String   // YYYY-MM, Bangkok calendar month
  score       Float
  amountCents Int
  status      String   @default("INITIAL") // "INITIAL", "PAYMENT_PENDING", "COMPLETED"
  paymentDate String?  // Latest matched bank transaction date, YYYY-MM-DD
  approvedById String?
  approvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, month])
  @@index([month])
}

model InvoiceSchedule {
  id          String   @id @default(cuid())
  client      String
  product     String
  service     String
  description String
  period      String   // "month", "quarter", or "year"
  issueDay    Int
  issueMonth  Int?
  amount      Float
  address     String
  name        String
  taxId       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([period, issueMonth, issueDay])
}

model Project {
  id          String          @id @default(cuid())
  name        String
  budget      Float           @default(0)
  clientName  String
  address     String
  taxId       String
  invoices    ProjectInvoice[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([name])
}

model ProjectInvoice {
  id                  String   @id @default(cuid())
  projectId           String
  project             Project  @relation(fields: [projectId], references: [id])
  installment         String
  invoiceDate         DateTime
  billingDescription  String
  amount              Float
  invoiceNumber       String   @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([invoiceDate])
  @@index([projectId, invoiceDate])
}

model IssuedDocument {
  id             String   @id @default(cuid())
  documentType   String   // "INVOICE" or "RECEIPT"
  sourceType     String   // "RECURRING" or "PROJECT"
  referenceKey   String
  documentNumber String   @unique
  status         String   @default("INITIAL")
  customer       String   @default("")
  description    String   @default("")
  invoiceMonth   String   @default("")
  netCents       Int?
  grossCents     Int?
  issuedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([documentType, sourceType, referenceKey])
  @@index([documentType, sourceType, issuedAt])
}

model VatSale {
  id           String   @id @default(cuid())
  referenceKey String   @unique
  sourceType   String
  sourceId     String
  invoiceMonth String
  invoiceNumber String
  customer     String
  description  String
  taxDate      DateTime
  amountCents  Int
  vatCents     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([taxDate])
}

model VatPurchase {
  id             String   @id @default(cuid())
  month          String
  purchaseDate   DateTime
  supplier       String
  invoiceNumber  String
  description    String
  amountCents    Int
  vatCents       Int
  creditable     Boolean  @default(false)
  expense        Boolean  @default(true)
  vatMode        String   @default("exclusive")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([supplier, invoiceNumber])
  @@index([month])
}

model VatMonth {
  month              String   @id
  openingCreditCents Int      @default(0)
  creditAction       String   @default("CARRY")
  updatedAt          DateTime @updatedAt
}

model KbizTransaction {
  id                 String   @id @default(cuid())
  fingerprint        String   @unique
  accountNumber      String
  transactionDate    String
  transactionTime    String
  bankDescription    String
  channel            String
  details            String
  withdrawalCents    Int
  depositCents       Int
  balanceCents       Int
  sourceFile         String
  expenseDescription String   @default("")
  expenseKind        String   @default("OTHER")
  updatedById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  allocations        KbizAllocation[]
  depositSuggestions KbizDepositSuggestion[]
  vendorAllocations  KbizVendorAllocation[]
  employeeAllocations KbizEmployeeAllocation[]
  taxAllocations      KbizTaxAllocation[]

  @@index([transactionDate])
}

model KbizAllocation {
  id             String @id @default(cuid())
  transactionId  String
  transaction    KbizTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  referenceKey   String
  invoiceNumber  String
  customer       String
  amountCents    Int
  expectedCents  Int
  basis          String

  @@unique([transactionId, referenceKey])
  @@index([referenceKey])
}

model KbizDepositSuggestion {
  id             String   @id @default(cuid())
  transactionId  String
  transaction    KbizTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  referenceKey   String
  invoiceNumber  String
  invoiceMonth   String
  customer       String
  amountCents    Int
  expectedCents  Int
  basis          String
  reason         String
  status         String   @default("PENDING")
  createdById    String
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())

  @@unique([transactionId, referenceKey])
  @@index([status])
}

model VendorPayment {
  id            String   @id @default(cuid())
  paymentNumber String   @unique
  vendorName    String
  taxId         String
  amountCents   Int
  withholdingRate Int @default(0)
  withholdingBaseCents Int @default(0)
  paymentDate   String
  description   String   @default("")
  status        String   @default("INITIAL")
  printedAt     DateTime?
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  allocations   KbizVendorAllocation[]
  withholdingPayables RevenueTaxPayment[]

  @@index([paymentDate])
}

model KbizVendorAllocation {
  id              String @id @default(cuid())
  transactionId   String
  transaction     KbizTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  vendorPaymentId String
  vendorPayment   VendorPayment @relation(fields: [vendorPaymentId], references: [id], onDelete: Restrict)
  amountCents     Int

  @@unique([transactionId, vendorPaymentId])
  @@index([vendorPaymentId])
}

model KbizEmployeeAllocation {
  id             String @id @default(cuid())
  transactionId  String
  transaction    KbizTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employeeName   String
  paymentType    String
  paymentMonth   String
  amountCents    Int

  @@unique([transactionId, employeeId, paymentType, paymentMonth])
  @@index([employeeId, paymentMonth])
}

model RevenueTaxPayment {
  id            String   @id @default(cuid())
  paymentNumber String   @unique
  paymentMonth  String
  amountCents   Int
  status        String   @default("INITIAL")
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  allocations   KbizTaxAllocation[]
  vendorPaymentId String?
  vendorPayment VendorPayment? @relation(fields: [vendorPaymentId], references: [id], onDelete: Restrict)

  @@unique([vendorPaymentId, paymentMonth])
  @@index([paymentMonth])
}

model KbizTaxAllocation {
  id             String @id @default(cuid())
  transactionId  String
  transaction    KbizTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  taxPaymentId   String
  taxPayment     RevenueTaxPayment @relation(fields: [taxPaymentId], references: [id], onDelete: Restrict)
  amountCents    Int

  @@unique([transactionId, taxPaymentId])
  @@index([taxPaymentId])
}
