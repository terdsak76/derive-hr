{
  "name": "derive-hr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build --webpack",
    "db:seed": "tsx prisma/seed.ts",
    "start": "next start",
    "lint": "next lint",
    "test:employees": "node --import tsx --test tests/employees.test.ts",
    "db:leave-period": "node scripts/apply-leave-period-migration.mjs",
    "db:workday-change-times": "node scripts/apply-workday-change-times-migration.mjs",
    "test:finance": "node --import tsx --test tests/finance.test.ts",
    "test:kbiz": "node --import tsx --test tests/kbiz.test.ts",
    "db:kbiz": "node scripts/apply-kbiz-migration.mjs",
    "db:kbiz-deposit-suggestions": "node scripts/apply-kbiz-deposit-suggestions-migration.mjs",
    "db:vendor-payments": "node scripts/apply-vendor-payment-migration.mjs",
    "db:employee-reconciliation": "node scripts/apply-employee-reconciliation-migration.mjs",
    "db:employee-kbiz-name": "node scripts/apply-employee-kbiz-name-migration.mjs",
    "db:revenue-tax-payments": "node scripts/apply-revenue-tax-payment-migration.mjs",
    "db:vendor-withholding": "node scripts/apply-vendor-withholding-migration.mjs",
    "db:document-status": "node scripts/apply-document-status-migration.mjs && node --import tsx scripts/backfill-document-status.ts",
    "kbiz:import": "node --import tsx scripts/import-kbiz.ts",
    "invoices:generate": "node --import tsx scripts/generate-recurring-documents.ts",
    "db:incentives": "node scripts/apply-incentive-migration.mjs",
    "db:incentive-payment-status": "node scripts/apply-incentive-payment-status-migration.mjs",
    "db:taxes": "node scripts/apply-tax-migration.mjs",
    "db:owners": "node scripts/apply-owner-migration.mjs",
    "db:full-incentive": "node scripts/apply-full-incentive-migration.mjs",
    "db:salary-history": "node scripts/apply-salary-history-migration.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/client": "^7.0.0",
    "lucide-react": "^0.400.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "autoprefixer": "^10.0.0",
    "dotenv": "^16.6.1",
    "postcss": "^8.0.0",
    "prisma": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
