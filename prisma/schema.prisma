datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Employee {
  id                     String                 @id @default(uuid())
  name                   String
  department             String
  position               String
  email                  String                 @unique
  passwordHash           String
  role                   String                 @default("USER")
  monthlySalaryCents     Int?
  attendances            Attendance[]
  leaves                 Leave[]
  onsites                Onsite[]
  workdayChanges         WorkdayChangeRequest[]
  approvedWorkdayChanges WorkdayChangeRequest[] @relation("ApprovedWorkdayChanges")
  overtimes              Overtime[]             @relation("OvertimeEmployee")
  createdOvertimes       Overtime[]             @relation("OvertimeCreator")
  approvedOvertimes      Overtime[]             @relation("OvertimeApprover")
  createdAt              DateTime               @default(now())
}

model Attendance {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  date       DateTime  @default(now())
  checkIn    DateTime?
  checkOut   DateTime?
  project    String?
  jobDetail  String?
  status     String // "PRESENT", "LATE", "ABSENT"
}

model Leave {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  type       String // "SICK", "PERSONAL", "VACATION"
  startDate  DateTime
  endDate    DateTime
  reason     String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
}

model WorkdayChangeRequest {
  id           String    @id @default(uuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  fromDate     DateTime
  toDate       DateTime
  project      String
  jobDetail    String
  status       String    @default("WAITING_FOR_APPROVAL")
  approvedById String?
  approvedBy   Employee? @relation("ApprovedWorkdayChanges", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
}

model Onsite {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  location   String
  purpose    String
  startDate  DateTime
  endDate    DateTime
  allowance  Float?
  status     String   @default("APPROVED")
  createdAt  DateTime @default(now())
}

model TravelConfig {
  id                   String   @id @default(cuid())
  month                String   @unique
  fuelPrice            Float
  carKmPerLiter        Float
  motorcycleKmPerLiter Float
  depreciationPerKm    Float
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Overtime {
  id              String   @id @default(uuid())
  employeeId      String
  employee        Employee @relation("OvertimeEmployee", fields: [employeeId], references: [id])
  startAt         DateTime
  endAt           DateTime
  workedMinutes   Int
  hourlyRateCents Int
  otAmountCents   Int
  createdById     String
  createdBy       Employee @relation("OvertimeCreator", fields: [createdById], references: [id])
  status          String   @default("PENDING_APPROVAL")
  approvedById    String?
  approvedBy      Employee? @relation("OvertimeApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([employeeId, startAt])
  @@index([startAt, createdAt])
  @@map("OT")
}

model InvoiceSchedule {
  id          String   @id @default(cuid())
  client      String
  product     String
  service     String
  description String
  period      String   // "month", "quarter", or "year"
  issueDay    Int
  issueMonth  Int?
  amount      Float
  address     String
  name        String
  taxId       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([period, issueMonth, issueDay])
}
